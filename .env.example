OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL + pgvector
POSTGRES_USER=maintenance_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=maintenance_db
# Для локального запуска (без Docker) host=localhost; внутри docker-compose host=postgres
POSTGRES_DSN=postgresql://maintenance_user:change_me@localhost:5432/maintenance_db

# RAG-конвейер
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.35

# LLM-агент
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_SEC=30.0

ALLOWED_ORIGINS=http://localhost:8501
API_URL=http://localhost:8000
